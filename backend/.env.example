# SwachhLens backend environment
# Copy to .env and fill in real values. DO NOT commit .env.

# --- Required in production ---
# JWT_SECRET: strong random string >= 32 chars (e.g. openssl rand -base64 48)
JWT_SECRET=
# CORS_ORIGIN: the exact frontend origin(s), comma-separated allowed. No "*".
CORS_ORIGIN=
# MONGODB_URI: Atlas/self-hosted connection string
MONGODB_URI=
# NODE_ENV: development | production
NODE_ENV=development

# --- Optional ---
PORT=8000
HOST=0.0.0.0
JWT_EXPIRES_IN=7d

# --- Admin seeding (npm run seed:admin) ---
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=your-strong-password

# --- Storage (local is default; set provider keys to enable remote) ---
# STORAGE_PROVIDER=local|imagekit|s3|gcs|azure
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_ENDPOINT_URL=

# --- ML ---
# ML_PROVIDER=stub|python
# ML_PYTHON_SERVICE_URL=http://localhost:8001
# ML_TIMEOUT_MS=30000

# --- Notifications (all default off) ---
# EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@swachhlens.local
# PUSH_ENABLED=false
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@swachhlens.local
# SMS_ENABLED=false

# --- Rate limiting ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
